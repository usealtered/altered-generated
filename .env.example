# Domains
APP_BASE_URL=https://generated.api.usealtered.com
SITE_BASE_URL=https://generated.usealtered.com
NEXT_PUBLIC_API_BASE_URL=https://generated.api.usealtered.com

# Neon
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require

# Upstash Redis (Chat SDK needs redis protocol URL)
REDIS_URL=rediss://default:TOKEN@HOST:6379
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash
QSTASH_TOKEN=
QSTASH_URL=https://qstash.upstash.io
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Sendblue (agent line)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+13054098546
SENDBLUE_WEBHOOK_SECRET=

# Cursor Cloud Agents
CURSOR_API_KEY=
# Optional bootstrap only — runtime uses dynamic agents in DB (cursor_agents / workstreams)
CURSOR_OPERATING_AGENT_ID=
CURSOR_DEFAULT_REPO_URL=https://github.com/usealtered/altered-generated
CURSOR_DEFAULT_REF=main

# Operator allowlist (Riley)
OPERATOR_PHONE_ALLOWLIST=+12368370221

# OpenRouter (AI SDK tool calling)
OPENROUTER_API_KEY=
CHAT_AGENT_MODEL_ID=anthropic/claude-sonnet-5

# Checkout (static Payment Link; deposit amount from knowledge/)
PRIMARY_CHECKOUT_URL=
EARLY_ACCESS_DEPOSIT_CURRENCY=usd

# Agent-only secret (Cloud Agent env): pull envs for altered/api-generated only — never other Vercel projects
# npx vercel link --token "$VERCEL_TOKEN" --scope altered --project api-generated --yes
# npx vercel env pull .env.local --token "$VERCEL_TOKEN" --environment production --yes
VERCEL_TOKEN=
