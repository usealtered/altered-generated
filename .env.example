# Core
NODE_ENV=development
APP_BASE_URL=https://your-api.vercel.app

# Neon
DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require

# Redis — Chat SDK state needs redis protocol URL from Upstash
REDIS_URL=rediss://default:TOKEN@HOST:6379

# Optional Upstash REST (operator memory / history)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# QStash (Cursor run polling + busy retries)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Sendblue iMessage
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=+1XXXXXXXXXX
SENDBLUE_WEBHOOK_SECRET=

# Cursor Cloud Agents API
CURSOR_API_KEY=
CURSOR_OPERATING_AGENT_ID=bc-019fec8e-b595-799e-a563-893350c98cc5
CURSOR_DEFAULT_REPO_URL=https://github.com/usealtered/altered-generated
CURSOR_DEFAULT_REF=main

# Operator allowlist (comma-separated E.164). Empty = allow all (dev only).
OPERATOR_PHONE_ALLOWLIST=+1XXXXXXXXXX

# Optional LLM polish for ask/
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Early access economics
EARLY_ACCESS_DEPOSIT_AMOUNT_CENTS=25000
EARLY_ACCESS_DEPOSIT_CURRENCY=usd

# Stripe (deposits)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_EARLY_ACCESS_PRICE_ID=

# Web
NEXT_PUBLIC_API_BASE_URL=https://your-api.vercel.app
